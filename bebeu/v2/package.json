{
  "name": "bebeu-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "bebeu internal PWA for work progress, photos, attendance, and export.",
  "scripts": {
    "start": "node server.js",
    "check:encoding": "node scripts/check-text-integrity.js",
    "check": "node --check server.js && node --check public/app.js && node --check public/sw.js && npm run check:encoding",
    "native:sync": "cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "iconv-lite": "^0.7.3",
    "mysql2": "^3.11.5",
    "playwright": "^1.55.0",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
