# Server
PORT=3000
PHOTO_ROOT=.\bebeu_image
LOG_DIR=.\app_logs
APP_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
UPLOAD_LIMIT_MB=600

# MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bebeu_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=bebeu

# Admin
DEFAULT_ADMIN_PASSWORD=change-me

# Naver Cafe integration
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_CAFE_CLUB_ID=your-cafe-club-id
NAVER_CAFE_MENU_ID=your-cafe-menu-id
NAVER_CAFE_MAX_ATTACHMENTS=20
NAVER_CAFE_RETRY_ATTACHMENTS=5
NAVER_CAFE_IMAGE_MAX_WIDTH=1600
NAVER_CAFE_AUTOMATION_HEADLESS=false
